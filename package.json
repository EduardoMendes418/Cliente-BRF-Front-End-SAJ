	"scripts": {
		"start": "vite",
		"build": "tsc && vite build",
		"serve": "vite preview",
		"lint": "eslint \"src/**/*.{js,ts,tsx}\"",
		"build:local": "cp src/config/environments/.env.local .env && yarn build",
		"build:dev": "cp src/config/environments/.env.dev .env && yarn build",
		"build:qa": "cp src/config/environments/.env.qa .env && yarn build",
		"build:prd": "cp src/config/environments/.env.prod .env && yarn build"
	},
	"importSort": {
		".ts, .tsx": {
			"parser": "typescript",
			"style": "renke",
			"options": {}
		},
		".es6, .es, .js, .jsx": {
			"parser": "babylon",
			"style": "renke",
			"options": {}
		}
	},
	"browserslist": {
		"production": [
			">0.2%",
			"not dead",
			"not op_mini all"
		],
		"development": [
			"last 1 chrome version",
			"last 1 firefox version",
			"last 1 safari version"
		]
	}
}
